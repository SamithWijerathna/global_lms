# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cloudwave_lms
CENTRAL_DB_NAME=cloudwave_lms_central

# Domain & App Config
NEXT_PUBLIC_ROOT_DOMAIN=lms.circleone.asia
NEXT_PUBLIC_BACKEND_API_URL=https://lms.circleone.asia
NEXT_PUBLIC_API_SECRET_TOKEN=global_lms_api_token_2026

# Session Security (Must be at least 32 characters long)
SESSION_SECRET=your_complex_32_character_cookie_password_here
SECRET_COOKIE_PASSWORD=your_complex_32_character_cookie_password_here

# Cloudflare R2 Object Storage (For Course Videos, PDFs & Materials)
# Obtain these from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=global-lms-media
R2_PUBLIC_DOMAIN=https://assets.circleone.asia
